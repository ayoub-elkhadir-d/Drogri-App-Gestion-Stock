<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.Drogri" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand Colors in Dark Mode -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorAccent">?attr/colorPrimary</item>
        <item name="colorControlActivated">?attr/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/accent_green</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Neutral Backgrounds & Surfaces in Dark Mode (Never tinted) -->
        <item name="android:windowBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <!-- Status Bar Styling in Dark Mode -->
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Typography / Font -->
        <item name="fontFamily">sans-serif</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Theme.Drogri" parent="Base.Theme.Drogri" />

    <!-- Rounded Material Card Style in Dark Mode - Always neutral -->
    <style name="Widget.MyStore.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/card_stroke</item>
        <item name="cardBackgroundColor">@color/surface</item>
    </style>

    <!-- App Logo Rounded Shape Style in Dark Mode -->
    <style name="ShapeAppearance.AppLogo" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">10dp</item>
    </style>

